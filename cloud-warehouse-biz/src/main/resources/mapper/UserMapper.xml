<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.yuncang.biz.mapper.UserMapper">
    <resultMap id="userMap" type="com.yuncang.biz.entity.AppUser">
        <id column="id" property="id"/>
        <result column="username" property="username"/>
        <result column="password_hash" property="passwordHash"/>
        <result column="role" property="role"/>
        <result column="enabled" property="enabled"/>
    </resultMap>
    <select id="findByUsername" resultMap="userMap">
        SELECT id, username, password_hash, role, enabled FROM app_user WHERE username = #{username}
    </select>
    <select id="findById" resultMap="userMap">
        SELECT id, username, password_hash, role, enabled FROM app_user WHERE id = #{id}
    </select>
</mapper>
