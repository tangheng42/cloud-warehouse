# Copy to .env for the local Docker Compose environment; replace both values.
MYSQL_ROOT_PASSWORD=replace-with-a-local-password
REDIS_PASSWORD=replace-with-another-local-password
# Application optional integration (set in the IDE or shell; no real credentials in this file):
# STOCK_CACHE_ENABLED=true
# REDIS_HOST=127.0.0.1
# NOTIFICATIONS_ENABLED=true
# RABBITMQ_HOST=127.0.0.1
# RABBITMQ_PORT=5672
# RABBITMQ_USERNAME=replace-with-a-local-user
# RABBITMQ_PASSWORD=replace-with-a-local-password
